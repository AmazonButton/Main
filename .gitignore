# =======================================================
# Git Ignore - Smart Order Button IoT Platform
# =======================================================

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets (NEVER push to git)
.env
.env.*
!.env.example

# Build Outputs & Compilation Caches
dist/
**/dist/
build/
**/build/
out/
.next/
.cache/
*.tsbuildinfo
**/*.tsbuildinfo

# Large Application Packages (Exceeds GitHub 100MB limit)
*.apk
*.aab
*.ipa
SmartOrder.apk

# Database & SQLite Local Files
*.db
*.db-journal
*.sqlite
*.sqlite3
backend/prisma/*.db
backend/prisma/*.db-journal

# Mobile / Flutter Build Artifacts
.dart_tool/
**/.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/app/release/

# Hardware & PlatformIO Build Artifacts
.pio/
.pioenvs/
.piolibdeps/

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & System Files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# AI Agents & IDE metadata
.gemini/
.agents/
